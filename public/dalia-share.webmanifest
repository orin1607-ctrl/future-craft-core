{
  "id": "./?app=dalia-staging",
  "name": "דליה – בדיקות",
  "short_name": "דליה",
  "description": "דליה (סביבת בדיקות) — שיתוף מסמכים ותמונות ישירות לתיקי תביעה",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./claims",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1e3a8a",
  "icons": [
    { "src": "dalia-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "dalia-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "dalia-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./claims/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf", ".pdf", ".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif"]
        }
      ]
    }
  }
}
