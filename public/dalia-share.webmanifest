{
  "id": "./?app=dalia-staging",
  "name": "דליה – ניהול תביעות ורכב",
  "short_name": "דליה",
  "description": "דליה (סביבת בדיקות) — שמירת מסמכים ותמונות ישירות לתביעות, מוסך ורכבים",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./claims/share",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0284c7",
  "icons": [
    {
      "src": "dalia-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "dalia-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "dalia-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./claims/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  }
}
