# Local development environment — copy this file to .env.local and fill in.
# DO NOT commit .env.local to git (already covered by .gitignore).
#
# These values point the LOCAL dev server at the STAGING Supabase project,
# so any change you make in Cursor affects the safe staging environment
# only. The live production system at dalia-car.online is never touched
# by anything that runs locally.

# Staging Supabase project: usfeoerkpcafxxlyuldl (dalia-staging)
VITE_SUPABASE_URL="https://usfeoerkpcafxxlyuldl.supabase.co"
VITE_SUPABASE_PROJECT_ID="usfeoerkpcafxxlyuldl"

# Public anon key for the staging project — safe to be in the browser
# bundle, but still don't commit this file. Yoni will provide the
# current value when you join the project.
VITE_SUPABASE_PUBLISHABLE_KEY="<paste-from-supabase-dashboard>"

# --- Notes ---
# * Service-role keys, database passwords, and API tokens are NEVER
#   placed here. They live in Supabase Edge Function Secrets.
# * If you ever need to debug against production data, set up a
#   read-only second .env (e.g. .env.production-readonly) — never
#   point a writable dev server at production.
