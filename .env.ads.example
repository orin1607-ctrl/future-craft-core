# Google Ads API — local secrets (gitignored)
# Copy: cp .env.ads.example .env.ads
# After filling: npm run project-001:ads-connect

# Required — from https://ads.google.com/aw/apicenter (sign in as orin1607@gmail.com)
GOOGLE_ADS_DEVELOPER_TOKEN=

# Optional — auto-picked from first accessible customer if empty
# Format: 1234567890 or 123-456-7890
GOOGLE_ADS_CUSTOMER_ID=

# Optional — only if accessing via MCC manager account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
